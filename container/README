These are notes for running the app in a pod or container 

# Build
1. Install podman 
	sudo apt install podman
2. create Dockerfile
3. create requirements.txt 
4. create app.py

# example podman commands
podman rm -f aprschat-app
podman build -t aprschat-app .
podman run -p 5001:5001 --name aprschat-app aprschat-app
podman ps 
podman stop <containerid> 
podman start aprschat-app
podman stop aprschat-app

# Install
1. Update the aprschat.config file with your info

# Running
podman rm -f aprschat-app
podman build -t aprschat-app .
podman run -p 5001:5001 --name aprschat-app aprschat-app
http://localhost:5001
podman stop aprschat-app
podman start aprschat-app
http://localhost:5001

