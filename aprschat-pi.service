[Unit]
Description=APRS webchat (aprschat) on Raspberry Pi
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/aprschat
ExecStart=/home/pi/aprschat/venv/bin/python3 app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
