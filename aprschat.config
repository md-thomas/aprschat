[settings]
callsign = K0MDT
passcode = 8598
# Starting defaults only -- the Map panel's Distance filter toggle and
# radius field override these live, same pattern as the device pickers
# above. When enabled, APRS-IS sends us traffic within radius_nm
# nautical miles of our own last reported position (range follows us as
# we move); when disabled, we only get traffic from the saved callsigns
# list instead.
radius_filter_enabled = true
radius_nm = 60

[bluetooth]
# Starting default only -- the Connection panel's device picker
# overrides this once you've selected a paired device there. MAC
# address of a Bluetooth KISS TNC (e.g. Mobilinkd TNC3/TNC4), found with
# `bluetoothctl devices` once paired. Leave blank to pick in the panel.
address =
# RFCOMM channel, if known. Leave blank to auto-detect via SDP, falling
# back to the TNC3/TNC4 defaults (6, then 1).
channel =

[usb]
# Starting default only -- the Connection panel's device picker
# overrides this once you've selected a USB device there. Serial device
# for a USB KISS TNC, e.g. /dev/ttyUSB0. Leave blank to pick in the panel.
port =
baudrate = 9600

[uvpro]
# Starting default only -- the Connection panel's device picker
# overrides this once you've selected a device there. MAC address of a
# UV-Pro/Benshi-class radio (BTech UV-Pro, Vero VR-N76, RadioOddity
# GA5WB), found with `bluetoothctl devices` once paired. This is a
# different Bluetooth protocol from the [bluetooth] KISS TNC above, so
# it gets its own address -- see uvpro_tnc.py. Leave blank to pick in
# the panel.
address =

[rf]
# Digipeater path used when sending over RF (Bluetooth, USB, or UV-Pro).
digipath = WIDE1-1,WIDE2-1
